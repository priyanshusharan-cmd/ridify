# ==========================================
# SERVER & DATABASE CONFIGURATION
# ==========================================
PORT=5001
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ridify

# ==========================================
# JWT AUTHENTICATION
# ==========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_STRING
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_REFRESH_SECRET=REPLACE_WITH_SEPARATE_64_BYTE_HEX_STRING
# Optional: Set token expirations (defaults to 24h and 7d)
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# APP SECURITY & ADMINS
# ==========================================
# Only these emails can use the Trash/Delete features
ADMIN_EMAILS=admin@yourdomain.com
# ADMIN_SECRET is REQUIRED — no default is acceptable in production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING

# Allowed origin for CORS and Socket.IO (set to your frontend URL in production, or * for mobile apps)
ALLOWED_ORIGIN=*

# ==========================================
# SECURITY TUNING
# ==========================================
BCRYPT_ROUNDS=12
MAX_FIELD_LENGTH=500

# Optional: Logger level (debug, info, warn, error)
LOG_LEVEL=debug

# ==========================================
# SOCKET.IO
# ==========================================
SOCKET_PING_INTERVAL=25000
SOCKET_PING_TIMEOUT=20000

# ==========================================
# RIDE CONSTANTS
# ==========================================
MAX_ROUTE_POINTS=500
MIN_RIDE_DISTANCE_KM=1.5
SEARCH_RADIUS_DEFAULT_M=2000
SEARCH_TIME_WINDOW_MS=3600000
CHAT_MAX_LENGTH=1000

# Maximum fare limits (optional)
MAX_FARE=9999
MAX_PRICE_RUPEES=99999

# ==========================================
# EMAILJS CONFIGURATION (OTP VERIFICATION)
# ==========================================
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# ==========================================
# GOOGLE APPS SCRIPT (ID VERIFICATION UPLOAD)
# ==========================================
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your_google_apps_script_id/exec

# ==========================================
# DOMAIN RESTRICTION
# ==========================================
# Leave empty to allow any email domain
ALLOWED_EMAIL_DOMAIN=
